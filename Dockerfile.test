# Pinned by SHA digest to satisfy OpenSSF Scorecard's Pinned-Dependencies check
# (PinnedDependenciesID: containerImage not pinned by hash). See Dockerfile for
# the rationale and Dependabot strategy; see .github/scorecard-pinned-deps.md
# for the full coverage matrix.
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . .

# Install package with test and blockchain dependencies
# Same hash-pinned lockfile as .github/workflows/test.yml; the package itself
# is installed editable with --no-deps because editable installs cannot be hashed.
RUN pip install --no-cache-dir --require-hashes -r requirements-ci.txt \
    && pip install --no-cache-dir --no-deps -e .

# Default: run full test suite
CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short", "-m", "not live_blockchain", "--color=yes"]
